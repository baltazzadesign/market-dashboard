# Keep the existing .env.local. Never paste real keys into source files.
KIS_APPKEY=
KIS_APPSECRET=
KIS_BASE=https://openapi.koreainvestment.com:9443
KIS_CUSTTYPE=P
KIS_FETCH_TIMEOUT_MS=8000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Required for the cron collector and authenticated manual refresh.
CRON_SECRET=
# Preserve your existing access code or set a new private value.
BALTATOOL_ACCESS_CODE=
# TR_066 acml_tr_pbmn: million_krw (default) -> /100 to display in 억원.
# Other supported response units: krw, eok_krw. Raw amount + unit are retained.
KIS_INDEX_TURNOVER_UNIT=million_krw
# Additional exchange closures (comma separated KST dates); existing 2026 list retained.
MARKET_HOLIDAYS=
