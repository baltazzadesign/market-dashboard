import { NextResponse, type NextRequest } from "next/server";
import { hasDashboardAccess } from "@/lib/balta-access";
export function proxy(request:NextRequest){
  const path=request.nextUrl.pathname;
  if(path==="/login"||path.startsWith("/api/auth/")||path==="/api/cron"||path==="/api/market/live")return NextResponse.next();
  if(hasDashboardAccess(request))return NextResponse.next();
  if(path.startsWith("/api/"))return NextResponse.json({ok:false,error:"로그인이 필요합니다."},{status:401});
  return NextResponse.redirect(new URL("/login",request.url));
}
export const config={matcher:["/((?!_next/static|_next/image|favicon.ico).*)"]};
