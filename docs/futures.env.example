# Add these lines to your existing .env.local. Do not replace the existing file.
# Existing server credentials (already used by the app):
# KIS_APPKEY=...
# KIS_APPSECRET=...
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# Explicit WebSocket credentials. No automatic fallback to the existing cash worker's key.
# KIS allows one WS session per account/appkey. Use an unused account/appkey if another WS worker runs.
KIS_FUTURES_WS_APPKEY=
KIS_FUTURES_WS_APPSECRET=

# Dedicated always-running worker; default 10s DB flush, minimum 5s.
FUTURES_FLUSH_MS=10000
FUTURES_SPOOL_DIR=.runtime/futures
# Optional only when your provider endpoint differs:
# KIS_FUTURES_WS_URL=ws://ops.koreainvestment.com:21000/tryitout

# Existing MARKET_HOLIDAYS applies to futures opening dates too.
# Special-session overrides: JSON mapping of KST opening dates. Example syntax only:
# FUTURES_SESSION_OVERRIDES={"YYYY-MM-DD":{"open":true,"dayOpen":"10:45","dayClose":"16:45","nightClosed":false}}
